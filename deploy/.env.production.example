# ============================================
# AI Lesson Builder Service - Production Config
# ============================================
# Copy this file to ../.env and fill in your values

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000
DEBUG=false
STREAM_TIMEOUT=60

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_KEY=sk-proj-xxx

# Vision Models (for image extraction)
# gpt-5.6-terra: Best quality, $2/M input, $12/M output
# gpt-4o: Legacy, $2.5/M input, $10/M output
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_SUGGESTIONS_MODEL=gpt-5.6-terra

# Guardrail Model (safety check - cheap)
# gpt-5.6-luna: Ultra cheap, $0.20/M input
OPENAI_GUARDRAIL_MODEL=gpt-5.6-luna
OPENAI_GUARDRAIL_ENABLED=true

# Lesson Generator Model
OPENAI_LESSON_MODEL=gpt-4.1

# Temperature settings
OPENAI_VISION_TEMPERATURE=0.2
OPENAI_LESSON_TEMPERATURE=0.7

# Token limits
OPENAI_VISION_MAX_TOKENS=16000
OPENAI_LESSON_MAX_TOKENS=8000

# V3 Parallel Processing
OPENAI_V3_PARALLEL_IMAGES=true
OPENAI_V3_IMAGES_PER_BATCH=1
OPENAI_V3_MAX_CONCURRENT=4

# ============================================
# External APIs
# ============================================
# Profile API
PROFILE_API_BASE_URL=https://robot-api.hacknao.edu.vn/robot/api/v1/llm
PROFILE_API_TOKEN=your-profile-api-token

# Memory API (Mem0)
MEM0_BASE_URL=http://42.96.40.125:8889
MEM0_TIMEOUT=5.0

# ============================================
# Langfuse - LLM Observability
# ============================================
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_TRACING_ENABLED=true

# ============================================
# Google Chat Alerting
# ============================================
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/xxx/messages?key=xxx&token=xxx
ALERTING_ENABLED=true

# ============================================
# API Security
# ============================================
X_API_KEY_ENABLED=true
X_API_KEY=your-api-key-for-clients

# Swagger UI Auth
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=change-this-password
